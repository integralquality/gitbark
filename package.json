{
  "name": "gitbark",
  "version": "1.0.0",
  "description": "Scan a git repo's commit history for exposed personal data (emails, real names, co-author leaks). Built for CI.",
  "type": "module",
  "bin": {
    "gitbark": "bin/gitbark.js"
  },
  "exports": {
    ".": "./src/core.js"
  },
  "files": [
    "bin",
    "src",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "gitbark": "node bin/gitbark.js",
    "test": "node --test"
  },
  "keywords": [
    "git",
    "pii",
    "privacy",
    "email",
    "security",
    "ci",
    "github-actions",
    "commit",
    "scanner"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/integralquality/gitbark.git"
  },
  "license": "MIT"
}
